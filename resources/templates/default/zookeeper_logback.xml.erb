<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generated by Chef for <%= node['hostname'] %>
  Rotation is handled by /etc/logrotate.d/zookeeper (copytruncate)
-->
<configuration>
  <appender name="file" class="ch.qos.logback.core.FileAppender">
    <file><%= @logdir %>/zookeeper.log</file>
    <append>true</append>
    <encoder>
      <pattern>[%d] %-5p %c{1}:%L - %m%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="file" />
  </root>
</configuration>
